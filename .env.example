# Financial Transaction Resolution MCP server configuration.
#
# Evidence tools need NO API keys and make no network calls. Synthesis via
# Gemini does require GEMINI_API_KEY.
#
# Copy to .env to override:  cp .env.example .env

# Name advertised to MCP clients.
SERVER_NAME=financial-transaction-resolution

# Version advertised to MCP clients.
SERVER_VERSION=0.1.0

# SQLite file holding the synthetic dataset, relative to the project root.
DATABASE_PATH=data/transactions.db

# Log level for the server's stderr logger: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Required for synthesize_investigation. Create a key at Google AI Studio.
GEMINI_API_KEY=

# Gemini model used to synthesize a customer-facing investigation reply.
GEMINI_MODEL=gemini-2.5-pro

# --- Opik agent observability (optional) ---
# Evidence tools and synthesis work without these. When set, MCP tool calls,
# Gemini synthesis (token usage, cost, LLM latency) and the HITL dispute
# workflow are traced, grouped by request_id. Create an account at
# https://www.comet.com/signup
# then copy the API key and workspace from the Opik settings page.
# Self-host instead: OPIK_USE_LOCAL=true and optionally OPIK_URL_OVERRIDE.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=financial-transaction-resolution
OPIK_USE_LOCAL=false
OPIK_URL_OVERRIDE=
OPIK_ENABLED=true

# Required only for --transport http. Create an MCP Server at
# https://app.descope.com/mcp-servers with Dynamic Client Registration enabled.
DESCOPE_CONFIG_URL=
BASE_URL=http://127.0.0.1:8000
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# How long a minted dispute approval_id remains usable (seconds).
APPROVAL_TTL_SECONDS=900
