# Sample .env for the Financial Transaction Resolution MCP server.
# Identical in structure to .env.example; the values here are placeholders.
#
# Evidence tools need no credentials. Synthesis needs GEMINI_API_KEY.

SERVER_NAME=financial-transaction-resolution
SERVER_VERSION=0.1.0
DATABASE_PATH=data/transactions.db
LOG_LEVEL=INFO
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro

# Optional Opik observability. Get a key at https://www.comet.com/signup
OPIK_API_KEY=your-opik-api-key
OPIK_WORKSPACE=your-opik-workspace
OPIK_PROJECT_NAME=financial-transaction-resolution
OPIK_USE_LOCAL=false
OPIK_URL_OVERRIDE=
OPIK_ENABLED=true
